# 실제 값은 /root/kr-jp-arbitrage/.env 에만 둔다 (git 제외).
# 없는 키는 시작 시 경고만 내고 해당 기능이 비활성화된다 (서비스 자체는 뜬다).

PORT=3016
UI_TOKEN=

# 한국 시장 최저가 (네이버쇼핑 검색 API, Phase 3)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 일본 시장 최저가 (Phase 2)
RAKUTEN_APP_ID=
YAHOO_CLIENT_ID=

# Google Sheets 보고
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=/root/kr-jp-arbitrage/sa.json

# Telegram 보고
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM 보조 매칭 (선택, Phase 3)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_DAILY_LIMIT=200

# 환율 안전마진 (한국 매입원가를 이 비율만큼 비싸게 가정)
FX_SAFETY_MARGIN=0.02

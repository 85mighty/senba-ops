# 실제 값은 /root/kr-jp-arbitrage/.env 에만 둔다 (git 제외).
# 없는 키는 시작 시 경고만 내고 해당 기능이 비활성화된다 (서비스 자체는 뜬다).

PORT=3016
UI_TOKEN=

# 네이버 쇼핑 검색 API는 2026-07-31 종료되어 기본으로 사용하지 않음. 되살아난 경우에만 NAVER_SHOP_ENABLED=1
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_SHOP_ENABLED=0

# 한국 시장가 보강 (선택): 쿠팡 파트너스 API (파트너스 로그인 > 도구 > 파트너스 API, 허용 IP에 서버 IP 등록)
# 호출 한도가 낮아 시간당 COUPANG_HOURLY_LIMIT회(기록은 DB에 저장돼 프로세스가 바뀌어도 유지)까지만 호출. 브랜드마다 검색어를 순환하며 쓴다. 403이 오면 10분 이상 쉴 것
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_MAX_CALLS=1
COUPANG_HOURLY_LIMIT=8

# 한국 시장가 보강: 11번가 Open API (openapi.11st.co.kr 에서 키 발급, 32자리, 유효기간 180일)
ELEVENST_API_KEY=

# 일본 시장 최저가 (Phase 2)
# 라쿠텐 신형 API(2026-07-01판): webservice.rakuten.co.jp 앱 등록 후
# Application ID(UUID)와 Access Key(pk_...) 둘 다 필요 (구형 20220601판은 2026-08 폐지)
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
YAHOO_CLIENT_ID=

# Google Sheets 보고
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=/root/kr-jp-arbitrage/sa.json

# Telegram 보고
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM 보조 매칭 (선택, Phase 3)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_DAILY_LIMIT=200

# 구글 쇼핑(일본) 가격 검색: DataForSEO (건당 과금. 이미 쓰는 계정이 있으면 같은 값)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
QUOTE_GOOGLE_BUDGET=10

# 시세 확인(quote) 단계: 목록에서 마진을 한눈에 보기 위한 매일 자동 계산
# 같은 품번이 DB에 없을 때만 외부 검색을 하며, 1회 실행당 검색 상품 수 상한
QUOTE_SEARCH_BUDGET=60
QUOTE_SEARCH_BUDGET_JP=15
# AI 이미지 비교(ANTHROPIC_API_KEY 필요): 이름 검색으로 찾은 +마진 결과를 이미지로 확인, 1회 실행당 상한
LLM_VISION_MODEL=claude-sonnet-5-5
LLM_VERIFY_LIMIT=30

# 환율 안전마진 (한국 매입원가를 이 비율만큼 비싸게 가정)
FX_SAFETY_MARGIN=0.02

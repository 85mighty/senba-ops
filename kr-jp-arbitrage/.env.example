# 실제 값은 /root/kr-jp-arbitrage/.env 에만 둔다 (git 제외).
# 없는 키는 시작 시 경고만 내고 해당 기능이 비활성화된다 (서비스 자체는 뜬다).

PORT=3016
UI_TOKEN=

# 네이버 쇼핑 검색 API는 2026-07-31 종료되어 기본으로 사용하지 않음. 되살아난 경우에만 NAVER_SHOP_ENABLED=1
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_SHOP_ENABLED=0

# 한국 시장가 보강 (선택): 쿠팡 파트너스 API (파트너스 로그인 > 도구 > 파트너스 API, 허용 IP에 서버 IP 등록)
# 호출 한도가 낮아 1회 실행당 호출 수를 COUPANG_MAX_CALLS(기본 2)로 제한. 403이 오면 10분 이상 쉴 것
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_MAX_CALLS=2

# 일본 시장 최저가 (Phase 2)
# 라쿠텐 신형 API(2026-07-01판): webservice.rakuten.co.jp 앱 등록 후
# Application ID(UUID)와 Access Key(pk_...) 둘 다 필요 (구형 20220601판은 2026-08 폐지)
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
YAHOO_CLIENT_ID=

# Google Sheets 보고
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=/root/kr-jp-arbitrage/sa.json

# Telegram 보고
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM 보조 매칭 (선택, Phase 3)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_DAILY_LIMIT=200

# 환율 안전마진 (한국 매입원가를 이 비율만큼 비싸게 가정)
FX_SAFETY_MARGIN=0.02

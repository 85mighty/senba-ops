# 동기화 비밀번호 — 기기마다 뷰어에 한 번 입력. 8자 이상, 길고 무작위로 (예: openssl rand -hex 12)
SYNC_TOKEN=
# 뷰어 주소(쉼표로 여러 개). 로컬 테스트를 하려면 http://localhost:5173 추가
ALLOW_ORIGIN=https://85mighty.github.io
PORT=3018
HOST=127.0.0.1
# nginx 에서 /kobe3d-api/ 그대로 넘기므로 접두사 유지
PATH_PREFIX=/kobe3d-api
DATA_DIR=/opt/kobe3d-sync/data
KEEP_HISTORY=50
